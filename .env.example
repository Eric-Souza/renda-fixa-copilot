# Copy to .env.local (gitignored) for local runs; set the same names as GitHub Actions secrets.

# Web search for bank offers and the summary. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Gmail account that sends the report, with an app password (needs 2-step verification):
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who gets it; defaults to GMAIL_USER
REPORT_TO=

# Amount to simulate, in reais
INVEST_AMOUNT=10000

# Optional: Postgres (e.g. Neon) to keep history and say what changed since the last report
DATABASE_URL=

# Optional overrides
# SEARCH_MODEL=groq/compound
# AI_PROVIDER=groq        # or google, with GOOGLE_GENERATIVE_AI_API_KEY
# AI_MODEL=
